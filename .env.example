# =============================================================================
# 复制为 .env 后填写：`cp .env.example .env`
#   同一份 .env 有两个用途（compose 变量插值 + web 容器密钥来源），故本文件被 gitignore 覆盖；
#   任何真实密钥都不得进仓库。
# =============================================================================

# ── 域名与证书（必填）────────────────────────────────────────────────────────
# 两条通道域名分工（本项目既定约定，勿混用）：
#   自托管 / Docker（本文件）→ kaup-ai.com
#   Vercel（现有通道）        → kaup.ai
# 主域名：acme-companion 用它决定证书落盘目录（/etc/nginx/certs/<主域>/）
ENTRY_HOST="kaup-ai.com"
# 附加域名（与主域共用一张多 SAN 证书）；只要一个域名时留空：ENTRY_ALT_HOST=""
ENTRY_ALT_HOST="www.kaup-ai.com"
# ACME 账号邮箱（到期提醒与恢复用）
ACME_EMAIL="ops@kaup-ai.com"

# ── ACME 挑战方式 ────────────────────────────────────────────────────────────
# 默认 HTTP-01：零密钥，只需 80 端口对外可达（80 端口 vhost 已预留挑战路径）
ACME_CHALLENGE="HTTP-01"
# DNS-01（80 不可达，或经 CDN 且挑战路径被吞时改用）：需 DNS 服务商 API 凭证
# ACME_CHALLENGE="DNS-01"
# ACMESH_DNS_API_CONFIG='{"DNS_API":"dns_ali","Ali_Key":"<AccessKeyId>","Ali_Secret":"<AccessKeySecret>"}'
# ACMESH_DNS_API_CONFIG='{"DNS_API":"dns_dp","DP_Id":"<id>","DP_Key":"<key>"}'
# ACMESH_DNS_API_CONFIG='{"DNS_API":"dns_cf","CF_Token":"<token>"}'
# 先用 Let's Encrypt 预演环境练手（避免正式环境速率限制）：
# ACME_CA_URI="https://acme-staging-v02.api.letsencrypt.org/directory"

# ── 入口可调项（留空即用 compose 默认值）─────────────────────────────────────
# ENTRY_RATE="30r/s"
# ENTRY_LIMIT_REQ="limit_req zone=site_in burst=60 nodelay;"
# ENTRY_CONNECT_TIMEOUT="5s"
# ENTRY_SEND_TIMEOUT="30s"
# ENTRY_READ_TIMEOUT="30s"
# ENTRY_CLIENT_MAX_BODY_SIZE="1m"
# ENTRY_RESOLVER="127.0.0.11"
# 入口前有 CDN / 云 SLB 时启用，恢复真实客户端 IP（否则应用侧 IP 限流会塌成一个桶）
# ENTRY_REAL_IP_CONFIG="set_real_ip_from 10.0.0.0/8; real_ip_header X-Forwarded-For; real_ip_recursive on;"

# ── 站点根 URL ───────────────────────────────────────────────────────────────
# 站点根 URL：写入 canonical / og:url / JSON-LD 与 robots、sitemap。
# 自托管通道固定 kaup-ai.com（构建期已由 Dockerfile 固化为此值；Vercel 通道在项目环境变量里设 https://kaup.ai）
NUXT_PUBLIC_SITE_URL="https://kaup-ai.com"

# ── 应用运行时密钥（server/api/contact.ts）───────────────────────────────────
# 缺 FEISHU_WEBHOOK_URL / FEISHU_BOT_SECRET ⇒ 表单提交返回 500「服务配置缺失」；
# 四个 BASE/APP 凭证任缺 ⇒ 静默跳过写表（主链路仍可用）。页面展示不受影响。
FEISHU_WEBHOOK_URL=""
FEISHU_BOT_SECRET=""
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
FEISHU_BASE_APP_TOKEN=""
FEISHU_BASE_TABLE_ID=""
